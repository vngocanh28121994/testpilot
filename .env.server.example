# Cấu hình chế độ `server`. Chép thành `.env.server` rồi sửa.
#
# Không đặt TESTPILOT_MODE thì mọi thứ dưới đây bị bỏ qua và TestPilot chạy ở
# chế độ embedded — một người, một máy, không đăng nhập.
TESTPILOT_MODE=server
TESTPILOT_UI_PORT=4300

# ── Đăng nhập (OIDC) ────────────────────────────────────────────────────────
# Đổi sang SSO của công ty = đổi ba dòng này. Code không biết mình đang nói
# chuyện với Keycloak hay Azure AD; nó chỉ đọc tài liệu discovery của issuer.
TESTPILOT_OIDC_ISSUER=http://localhost:8080/realms/testpilot
TESTPILOT_OIDC_CLIENT_ID=testpilot
TESTPILOT_OIDC_CLIENT_SECRET=testpilot-dev-secret
TESTPILOT_OIDC_REDIRECT_URI=http://localhost:4300/api/auth/callback

# ── Dữ liệu dùng chung ──────────────────────────────────────────────────────
TESTPILOT_DATABASE_URL=postgres://testpilot:testpilot-dev@localhost:5432/testpilot

# ── Artifact ────────────────────────────────────────────────────────────────
# MinIO nói đúng API của S3. Lên AWS thật thì bỏ ENDPOINT đi và đổi khoá.
TESTPILOT_S3_ENDPOINT=http://localhost:9000
TESTPILOT_S3_BUCKET=testpilot-artifacts
TESTPILOT_S3_ACCESS_KEY=testpilot
TESTPILOT_S3_SECRET_KEY=testpilot-dev
TESTPILOT_S3_REGION=us-east-1

# ── Thiết bị cắm vào chính máy chủ ──────────────────────────────────────────
# Bật khi máy chủ CŨNG là máy cắm điện thoại — một device farm nhỏ, cả nhóm
# vào web để dùng những chiếc điện thoại cắm ở đây. Không cần token hay runner
# riêng cho máy này. Để tắt khi máy chủ nằm trong container/cloud: lúc ấy máy
# chủ web không được chạy Appium hay adb, và thiết bị nối vào qua runner.
# TESTPILOT_HOST_DEVICES=1
