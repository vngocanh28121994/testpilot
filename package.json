{
  "name": "testpilot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Doc -> Gherkin -> cross-platform (web + native) test execution with self-healing locators and flake detection.",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "prepare": "husky",
    "build": "tsc -p tsconfig.json && npm run ui:build",
    "typecheck": "tsc -p tsconfig.check.json && tsc -b ui",
    "ui": "npm run ui:build && tsx watch src/ui/server.ts",
    "ui:dev": "vite --config ui/vite.config.ts",
    "ui:build": "tsc -b ui && vite build --config ui/vite.config.ts",
    "ui:preview": "vite preview --config ui/vite.config.ts",
    "ui:typecheck": "tsc -b ui",
    "ui:lint": "eslint ui",
    "ui:test": "vitest run --config ui/vitest.config.ts",
    "ui:test:coverage": "vitest run --coverage --config ui/vitest.config.ts",
    "ui:test:watch": "vitest --config ui/vitest.config.ts",
    "ui:test:e2e": "playwright test --config ui/playwright.config.ts",
    "smoke": "tsx scripts/smoke.ts",
    "gen": "tsx src/cli/gen.ts",
    "run:web": "tsx src/cli/run.ts --platform web",
    "run:android": "tsx src/cli/run.ts --platform android",
    "run:ios": "tsx src/cli/run.ts --platform ios",
    "run:parallel": "tsx src/cli/run-parallel.ts",
    "farm:bundle": "npm run build && bash scripts/bundle-farm.sh",
    "farm": "tsx src/cli/farm.ts",
    "flake": "tsx scripts/flake-forget.ts",
    "pom": "tsx src/cli/pom.ts",
    "crawl": "tsx src/cli/crawl.ts",
    "farm:pull": "tsx src/cli/farm-pull.ts",
    "rerender": "tsx scripts/rerender.ts",
    "backfill:device": "tsx scripts/backfill-device.ts",
    "test:ui": "tsx watch src/dev/test-runner-server.ts",
    "test:mcp": "node --import tsx/esm --test src/discovery/mcp/__tests__/PlaywrightMcpObserver.test.ts",
    "test:draft": "node --import tsx/esm --test src/genspec/__tests__/draft.test.ts src/steps/__tests__/normalizer.test.ts",
    "test": "node --import tsx/esm --test \"src/**/!(*.integration).test.ts\"",
    "test:integration": "node --import tsx/esm --test \"src/**/*.integration.test.ts\"",
    "devices:sync": "tsx src/cli/devices-sync.ts",
    "bench:ai": "tsx scripts/bench-ai-discovery.ts",
    "show:run": "tsx scripts/show-run.ts",
    "locators:import": "tsx src/cli/locators-import.ts",
    "locators:verify": "tsx src/cli/locators-verify.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.68.0",
    "@aws-sdk/client-device-farm": "^3.700.0",
    "@aws-sdk/client-s3": "^3.1136.0",
    "@aws-sdk/s3-request-presigner": "^3.1136.0",
    "@cucumber/gherkin": "^32.0.0",
    "@cucumber/messages": "^27.0.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@playwright/mcp": "^0.0.79",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.102.7",
    "@tanstack/react-router": "^1.170.32",
    "@tanstack/react-router-devtools": "^1.167.1",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.34.0",
    "pg": "^8.23.0",
    "playwright": "^1.49.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "webdriverio": "^9.4.0",
    "zod": "^3.24.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@tanstack/react-query-devtools": "^5.102.7",
    "@tanstack/router-plugin": "^1.168.35",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "fast-check": "^3.23.2",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^15.4.3",
    "msw": "^2.15.0",
    "prettier": "^3.5.3",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "lint-staged": {
    "ui/**/*.{ts,tsx,css,json,md}": [
      "prettier --write"
    ]
  }
}
