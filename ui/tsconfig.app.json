{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "esnext",

    // "node" là bắt buộc, không phải tuỳ chọn — xem UI-MIGRATION-PLAN §6.1a.
    // `import type` từ ../src/ kéo src/config.ts vào program, mà file đó mở đầu
    // bằng `import { existsSync } from 'node:fs'`. `import type` chỉ xoá emit,
    // không xoá typecheck. Thiếu "node" ở đây là 3 lỗi TS2307 ngay ở Phase 2.
    "types": ["vite/client", "node"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    // Hàng rào chính của R2: ai viết `import { X }` thay vì `import type { X }`
    // qua ranh giới ui/ → src/ sẽ gãy ngay tại đây, trước khi Vite kịp bundle.
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Strict */
    "strict": true,
    "noUncheckedIndexedAccess": true,

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,

    /* Path aliases */
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      // Chỉ để TS đọc type của backend. Vite KHÔNG có alias tương ứng (§6.1c).
      "@core/*": ["../src/*"]
    }
    // KHÔNG có "ignoreDeprecations": "6.0" như sen — cờ đó chỉ có nghĩa với
    // TS 6, còn repo này cố ý ở lại 5.9.x (§6.4).
  },
  "include": ["src"],
  "exclude": [
    "src/test/**",
    "src/**/__tests__/**",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/*.spec.ts",
    "src/**/*.spec.tsx"
  ]
}
